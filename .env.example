# Режим отладки (true/false)
DEBUG_MODE=false

# Горячая клавиша для захвата скриншота (поддерживает комбинации, например: alt+enter, f1, print_screen)
HOTKEY=print_screen

# Город рынка (выбирается в меню перед мониторингом)
# Доступные города: Martlock, Thetford, Lymhurst, Bridgewatch, Fort Sterling, Black Market, Caerleon
MARKET_CITY=

# Путь к Tesseract OCR (используйте двойные слеши \\ или прямой слеш /)
TESSERACT_PATH=C:\Users\USERNAME\AppData\Local\Programs\Tesseract-OCR\tesseract.exe

# Язык OCR
OCR_LANG=rus+eng

# Папка для скриншотов (относительно корня проекта)
SCREENSHOTS_DIR=screenshots

# Файл выходных данных
DATA_FILE=market_data.csv

# Файл конфигурации ROI
ROI_CONFIG_FILE=roi_config.json

# Путь к items.json каталогу
ITEMS_CATALOG_PATH=items.json

# Файл примера для калибровки
EXAMPLE_FILE=example.png
